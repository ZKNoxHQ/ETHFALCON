# Compiler files
cache/
out/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs
docs/

# Dotenv file
.env

# Falcon key and signature files written by pythonref/sign_cli.py
# (private_key.pem holds a secret key: never commit it, wherever it is)
private_key.pem
public_key.pem
/sig
pythonref/sig

# Python
pythonref/myenv/
__pycache__/
*.pyc

/script/deploy_privateVerifier.sh
/script/deploy_privateFalcon.sh

# C built files
falcon/nistfalcon/build/*.o
# KAT files NIST
falcon/nistfalcon/*.req
falcon/nistfalcon/*.rsp
