/// @dev inverse t = 64, 128, 256 of the product
function _f10ProdInvA(uint256[] memory A) pure {
    assembly ("memory-safe") {
        // block 0: words 0..63
        {
            let p := add(A, 0x20)
            for { let e := add(p, 0x100) } lt(p, e) { p := add(p, 32) } {
                let b0, b1, b2, b3
                {
                    let u := mload(p)
                    let v := mload(add(p, 0x100))
                    let t := mul(sub(add(u, _F10_Q8x5), v), 0xa13)
                    t := shr(16, add(t, mul(and(mul(and(t, _F10_M16), 12287), _F10_M16), 12289)))
                    u := add(u, v)
                    v := mload(add(p, 0x200))
                    let w := mload(add(p, 0x300))
                    let s := mul(sub(add(v, _F10_Q8x5), w), 0x128f)
                    s := shr(16, add(s, mul(and(mul(and(s, _F10_M16), 12287), _F10_M16), 12289)))
                    v := add(v, w)
                    w := mul(sub(add(u, _F10_Q8x8), v), 0x9e2)
                    w := shr(16, add(w, mul(and(mul(and(w, _F10_M16), 12287), _F10_M16), 12289)))
                    b0 := add(u, v)
                    b2 := w
                    w := mul(sub(add(t, _F10_Q8x8), s), 0x9e2)
                    w := shr(16, add(w, mul(and(mul(and(w, _F10_M16), 12287), _F10_M16), 12289)))
                    b1 := add(t, s)
                    b3 := w
                }
                {
                    let u := mload(add(p, 0x400))
                    let v := mload(add(p, 0x500))
                    let t := mul(sub(add(u, _F10_Q8x5), v), 0x1940)
                    t := shr(16, add(t, mul(and(mul(and(t, _F10_M16), 12287), _F10_M16), 12289)))
                    u := add(u, v)
                    v := mload(add(p, 0x600))
                    let w := mload(add(p, 0x700))
                    let s := mul(sub(add(v, _F10_Q8x5), w), 0x2db7)
                    s := shr(16, add(s, mul(and(mul(and(s, _F10_M16), 12287), _F10_M16), 12289)))
                    v := add(v, w)
                    w := mul(sub(add(u, _F10_Q8x8), v), 0x177e)
                    w := shr(16, add(w, mul(and(mul(and(w, _F10_M16), 12287), _F10_M16), 12289)))
                    u := add(u, v)
                    v := mul(sub(add(t, _F10_Q8x8), s), 0x177e)
                    v := shr(16, add(v, mul(and(mul(and(v, _F10_M16), 12287), _F10_M16), 12289)))
                    t := add(t, s)
                    s := mul(sub(add(b0, _F10_Q8x16), u), 0x439)
                    s := shr(16, add(s, mul(and(mul(and(s, _F10_M16), 12287), _F10_M16), 12289)))
                    mstore(add(p, 0x400), s)
                    b0 := add(b0, u)
                    b0 := sub(b0, mul(and(shr(18, mul(b0, 21)), _F10_Q5), 12289))
                    mstore(p, b0)
                    s := mul(sub(add(b1, _F10_Q8x16), t), 0x439)
                    s := shr(16, add(s, mul(and(mul(and(s, _F10_M16), 12287), _F10_M16), 12289)))
                    mstore(add(p, 0x500), s)
                    b1 := add(b1, t)
                    b1 := sub(b1, mul(and(shr(18, mul(b1, 21)), _F10_Q5), 12289))
                    mstore(add(p, 0x100), b1)
                    s := mul(sub(add(b2, _F10_Q8x16), w), 0x439)
                    s := shr(16, add(s, mul(and(mul(and(s, _F10_M16), 12287), _F10_M16), 12289)))
                    mstore(add(p, 0x600), s)
                    b2 := add(b2, w)
                    b2 := sub(b2, mul(and(shr(18, mul(b2, 21)), _F10_Q5), 12289))
                    mstore(add(p, 0x200), b2)
                    s := mul(sub(add(b3, _F10_Q8x16), v), 0x439)
                    s := shr(16, add(s, mul(and(mul(and(s, _F10_M16), 12287), _F10_M16), 12289)))
                    mstore(add(p, 0x700), s)
                    b3 := add(b3, v)
                    b3 := sub(b3, mul(and(shr(18, mul(b3, 21)), _F10_Q5), 12289))
                    mstore(add(p, 0x300), b3)
