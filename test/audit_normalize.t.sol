    function testBaseline() public view {
        (uint256[] memory pkc, uint256[] memory s2, uint256[] memory hashed) = _loadValid();
        bool result = falcon_core(s2, pkc, hashed);
        assertTrue(result, "unmodified KAT signature must verify");
    }

    function testMalleability_addQToFirstCoeff() public view {
        (uint256[] memory pkc, uint256[] memory s2, uint256[] memory hashed) = _loadValid();
        // The bottom 16 bits of s2[0] hold the 0th uncompressed coefficient = 157.
        // 157 + q = 12446, still < 65536, so no carry into the next coefficient slot.
        s2[0] = s2[0] + q; // q = 12289
        bool result = falcon_core(s2, pkc, hashed);
        // If the s2-norm check were actually executed, ||s2_new||^2 would jump by
        // (q - 157)^2 - 157^2 ~ 1.47e8 (only this one coefficient's centered
        // representative is now near q/2), pushing total norm well above
        // sigBound = 34034726. Expected: result == false. A passing-true here
        // confirms the s2 contribution is silently dropped from the norm.
        console.log("malleable s2 + q[0] -> result:", result);
        assertFalse(result, "BUG: signature with s2[0]+=q still verifies (s2-norm not checked)");
    }

    function testMalleability_addQToManyCoeffs() public view {
        (uint256[] memory pkc, uint256[] memory s2, uint256[] memory hashed) = _loadValid();
        // Add q to every 16-bit coefficient where it won't overflow (orig + q < 65536).
        // Most original coefficients are < q or close to q (Falcon coefficients are
        // in centered representation around q/2 with small magnitudes), so they all
        // fit. We use a simpler approach: every other coeff. Even adding q to ONE
        // coefficient alone should be enough to exceed sigBound.
        for (uint256 i = 0; i < 32; i++) {
            // bump every 16-bit slot in word i by q if there's headroom
            uint256 w = s2[i];
            uint256 nw = 0;
            for (uint256 j = 0; j < 16; j++) {
                uint256 c = (w >> (j * 16)) & 0xFFFF;
                if (c + q < 65536) c = c + q;
                nw |= (c << (j * 16));
            }
            s2[i] = nw;
        }
        bool result = falcon_core(s2, pkc, hashed);
        console.log("malleable s2 (mass +q) -> result:", result);
        assertFalse(result, "BUG: large-coeff s2 still verifies");
    }
