// SPDX-License-Identifier: MIT
// Regression test: the ERC-1271-style verify wrapper must only accept the
// canonical signature encoding salt (40 bytes) || s2 (1024 bytes) = 1064 bytes.
// Before the fix, floor division of (length - 40) by 32 accepted any length in
// [1064, 1095], giving up to 32 distinct valid byte encodings per signature.
pragma solidity ^0.8.25;

import {Test} from "forge-std/Test.sol";
import "../src/ZKNOX_falcon_utils.sol";
import "../src/ZKNOX_ethfalcon.sol";

contract SigLengthTest is Test {
