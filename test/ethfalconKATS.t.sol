pragma solidity ^0.8.25;

import {Test, console} from "forge-std/Test.sol";
import "../src/ZKNOX_falcon_encodings.sol";
import "../src/ZKNOX_ethfalcon.sol";
import "./ZKNOX_display.sol";

contract ETHFalconKATS_Test is Test {
    ZKNOX_ethfalcon falcon = new ZKNOX_ethfalcon();

    //kat vector 0 from the ZKNOX C signer built with -DETHFALCON (PQCsignKAT_falcon512int_zknox_eth.rsp, count = 0).
    //The key is the NTT-form key of count 0 (same keypair as PQCsignKAT_falcon512int_zknox.rsp).
    function test_kats_vector0_from_c() public {
        // forgefmt: disable-next-line
        bytes memory pk=hex"";// forgefmt: disable-next-line
        bytes memory sm=hex"";

        bytes memory salt = new bytes(40);
        for (uint256 k = 0; k < 40; k++) {
            salt[k] = sm[2 + k];
        }
        bytes memory message = new bytes(33);
        for (uint256 k = 0; k < 33; k++) {
            message[k] = sm[2 + 40 + k];
        }
        uint256[] memory s2 = new uint256[](512);
        for (uint256 k = 0; k < 512; k++) {
            s2[k] = uint256(uint8(sm[2 + 40 + 33 + 1 + 2 * k])) << 8 | uint256(uint8(sm[2 + 40 + 33 + 1 + 2 * k + 1]));
        }
        uint256[] memory kpub = new uint256[](512);
        for (uint256 k = 0; k < 512; k++) {
            kpub[k] = uint256(uint8(pk[1 + 2 * k])) << 8 | uint256(uint8(pk[1 + 2 * k + 1]));
        }

        uint256[] memory cs2;

        // The ZKNOX C signer (nist16.c, PQCsignKAT_falcon512int_zknox*.rsp) outputs the public key
        // already in the NTT domain: pk = 0x09 || NTT(h)[i] as 16-bit big-endian words. Use it as-is
        // (compact only); applying _ZKNOX_NTTFW_vectorized again would reject every current C signature.
        uint256[] memory ntth = _ZKNOX_NTT_Compact(kpub);

        cs2 = _ZKNOX_NTT_Compact(s2);

        bool result = falcon.verify(message, salt, cs2, ntth);
        console.log("result", result);
        assertEq(true, result);
    }

    //kat vector 1 from the ZKNOX C signer built with -DETHFALCON (PQCsignKAT_falcon512int_zknox_eth.rsp, count = 1).
    //The key is the NTT-form key of count 1 (same keypair as PQCsignKAT_falcon512int_zknox.rsp).
    function test_kats_vector1_from_c() public {
        // forgefmt: disable-next-line
        uint256 mlen = 66;
        bytes memory pk =
            hex""; // forgefmt: disable-next-line
        bytes memory sm=hex"";

        bytes memory salt = new bytes(40);
        for (uint256 k = 0; k < 40; k++) {
            salt[k] = sm[2 + k];
        }
        bytes memory message = new bytes(mlen);
        for (uint256 k = 0; k < mlen; k++) {
            message[k] = sm[2 + 40 + k];
        }
        uint256[] memory s2 = new uint256[](512);
        for (uint256 k = 0; k < 512; k++) {
            s2[k] =
                uint256(uint8(sm[2 + 40 + mlen + 1 + 2 * k])) << 8 | uint256(uint8(sm[2 + 40 + mlen + 1 + 2 * k + 1]));
        }
        uint256[] memory kpub = new uint256[](512);
        for (uint256 k = 0; k < 512; k++) {
            kpub[k] = uint256(uint8(pk[1 + 2 * k])) << 8 | uint256(uint8(pk[1 + 2 * k + 1]));
        }

        uint256[] memory cs2;

        // The ZKNOX C signer (nist16.c, PQCsignKAT_falcon512int_zknox*.rsp) outputs the public key
        // already in the NTT domain: pk = 0x09 || NTT(h)[i] as 16-bit big-endian words. Use it as-is
        // (compact only); applying _ZKNOX_NTTFW_vectorized again would reject every current C signature.
        uint256[] memory ntth = _ZKNOX_NTT_Compact(kpub);

        cs2 = _ZKNOX_NTT_Compact(s2);

        bool result = falcon.verify(message, salt, cs2, ntth);
        console.log("result", result);
        assertEq(true, result);
    }
}
