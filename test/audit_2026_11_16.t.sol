    // ------------------------------------------------------------------ L-3: ntth range

    function test_L3_falcon_ntthPlusQRejectedInVerify() public view {
        (uint256[] memory pk, uint256[] memory s2, bytes memory salt) = _falconVector();
        bytes memory message = abi.encodePacked(DIGEST);
        assertTrue(falcon.verify(message, salt, s2, pk));
        // first and last coefficient (exercises the lowest and highest SWAR slots)
        uint256[2] memory words = [uint256(0), 31];
        uint256[2] memory lanes = [uint256(0), 15];
        for (uint256 k = 0; k < 2; k++) {
            uint256[] memory bad = _toDyn(_copy32(pk));
            _setCoeff(bad, words[k], lanes[k], _getCoeff(pk, words[k], lanes[k]) + q);
            assertFalse(falcon.verify(message, salt, s2, bad), "ntth coefficient + q must be rejected");
        }
    }

    function test_L3_ethfalcon_ntthPlusQRejectedInVerify() public view {
        (uint256[] memory pk, uint256[] memory s2, bytes memory salt) = _ethfalconVector();
        bytes memory message = abi.encodePacked(DIGEST);
        assertTrue(ethfalcon.verify(message, salt, s2, pk));
        for (uint256 lane = 0; lane < 16; lane++) {
            uint256[] memory bad = _toDyn(_copy32(pk));
            _setCoeff(bad, 7, lane, _getCoeff(pk, 7, lane) + q);
            assertFalse(ethfalcon.verify(message, salt, s2, bad), "ntth coefficient + q must be rejected");
        }
    }

    function test_L3_setKeyRejectsCoefficientOutOfRange() public {
        (uint256[] memory pk,,) = _ethfalconVector();
        uint256[3] memory values = [q, q + 1, 0xffff];
        for (uint256 k = 0; k < 3; k++) {
            uint256[] memory bad = _toDyn(_copy32(pk));
            _setCoeff(bad, 31, 15, values[k]);
            vm.expectRevert(bytes("invalid public key"));
            ethfalcon.setKey(abi.encode(bad));
            vm.expectRevert(bytes("invalid public key"));
            falcon.setKey(abi.encode(bad));
        }
        uint256[] memory edge = _toDyn(_copy32(pk));
        _setCoeff(edge, 0, 0, q - 1);
        ethfalcon.setKey(abi.encode(edge)); // q - 1 is in range
    }

    function test_L3_setKeyRejectsNonCanonicalEncoding() public {
        (uint256[] memory pk,,) = _ethfalconVector();
        bytes memory good = abi.encode(pk);
        assertEq(good.length, FALCON_PK_ENCODED_LEN);

        // trailing byte
        vm.expectRevert(bytes("invalid public key"));
        ethfalcon.setKey(bytes.concat(good, hex"00"));
        // wrong number of words
        vm.expectRevert(bytes("invalid public key"));
        ethfalcon.setKey(abi.encode(new uint256[](31)));
        // non-canonical offset word
        bytes memory badOffset = bytes.concat(good);
        badOffset[31] = 0x21;
        vm.expectRevert(bytes("invalid public key"));
        ethfalcon.setKey(badOffset);
        // raw packed words (no ABI header)
        vm.expectRevert(bytes("invalid public key"));
        ethfalcon.setKey(abi.encodePacked(pk));
    }

    function test_L3_I4_falconCoreRejectsBadNtthLength() public pure {
        (uint256[] memory pk, uint256[] memory s2,) = _ethfalconVector();
        uint256[] memory hashed = new uint256[](512);
        uint256[] memory shortKey = new uint256[](31);
        for (uint256 i = 0; i < 31; i++) {
            shortKey[i] = pk[i];
        }
        assertFalse(falcon_core(s2, shortKey, hashed));
    }

    function test_L3_checkCompactRange() public pure {
        uint256[] memory a = new uint256[](32);
        for (uint256 i = 0; i < 32; i++) {
            for (uint256 j = 0; j < 16; j++) {
                _setCoeff(a, i, j, q - 1);
            }
        }
        assertTrue(falcon_checkCompactRange(a));
        for (uint256 j = 0; j < 16; j++) {
            uint256 saved = a[5];
            _setCoeff(a, 5, j, q);
            assertFalse(falcon_checkCompactRange(a));
            a[5] = saved;
        }
        assertFalse(falcon_checkCompactRange(new uint256[](31)));
        assertFalse(falcon_checkCompactRange(new uint256[](33)));
    }

    function testFuzz_L3_checkCompactRangeMatchesNaive(uint256 w, uint8 word) public pure {
        uint256[] memory a = new uint256[](32);
        a[word % 32] = w;
        bool expected = true;
        for (uint256 j = 0; j < 16; j++) {
            if (((w >> (16 * j)) & 0xffff) >= q) expected = false;
        }
        assertEq(falcon_checkCompactRange(a), expected);
    }

    // ------------------------------------------------------------------ L-2: ERC-7913 key bytes

    function _ethfalconSig() internal pure returns (uint256[] memory pk, bytes memory sig) {
        uint256[] memory s2;
        bytes memory salt;
        (pk, s2, salt) = _ethfalconVector();
        sig = abi.encodePacked(salt, s2);
    }

    function test_L2_validKeyVerifies() public {
        (uint256[] memory pk, bytes memory sig) = _ethfalconSig();
        bytes memory pubkey = ethfalcon.setKey(abi.encode(pk));
        assertEq(pubkey.length, 20);
        assertEq(address(bytes20(pubkey)).code.length, FALCON_PK_CODE_SIZE);
        assertEq(ethfalcon.verify(pubkey, DIGEST, sig), ISigVerifier.verify.selector);

        (uint256[] memory fpk, uint256[] memory fs2, bytes memory fsalt) = _falconVector();
        bytes memory fpubkey = falcon.setKey(abi.encode(fpk));
        assertEq(falcon.verify(fpubkey, DIGEST, abi.encodePacked(fsalt, fs2)), ISigVerifier.verify.selector);
    }

    function test_L2_pubkeyLengthNot20Rejected() public {
        (uint256[] memory pk, bytes memory sig) = _ethfalconSig();
        bytes memory pubkey = ethfalcon.setKey(abi.encode(pk));

        vm.expectRevert(bytes("invalid public key length"));
        ethfalcon.verify(bytes.concat(pubkey, hex"00"), DIGEST, sig); // trailing byte
        vm.expectRevert(bytes("invalid public key length"));
        ethfalcon.verify(bytes.concat(pubkey, hex"deadbeef"), DIGEST, sig);
        bytes memory truncated = new bytes(19);
        for (uint256 i = 0; i < 19; i++) {
            truncated[i] = pubkey[i];
        }
        vm.expectRevert(bytes("invalid public key length"));
        ethfalcon.verify(truncated, DIGEST, sig);
        vm.expectRevert(bytes("invalid public key length"));
        ethfalcon.verify("", DIGEST, sig);
        vm.expectRevert(bytes("invalid public key length"));
        falcon.verify(bytes.concat(pubkey, hex"00"), DIGEST, sig);
    }

    function test_L2_pointerWithWrongCodeRejected() public {
        (uint256[] memory pk, bytes memory sig) = _ethfalconSig();

        // no code
        vm.expectRevert(bytes("invalid public key"));
        ethfalcon.verify(abi.encodePacked(address(0xdead)), DIGEST, sig);
        // a contract of another size
        vm.expectRevert(bytes("invalid public key"));
        ethfalcon.verify(abi.encodePacked(address(ethfalcon)), DIGEST, sig);
        // an SSTORE2 pointer one byte too long (key || 0x00)
        address longer = SSTORE2.write(bytes.concat(abi.encode(pk), hex"00"));
        vm.expectRevert(bytes("invalid public key"));
        ethfalcon.verify(abi.encodePacked(longer), DIGEST, sig);
        vm.expectRevert(bytes("invalid public key"));
        falcon.verify(abi.encodePacked(longer), DIGEST, sig);
    }

    function test_L2_pointerWithoutLeadingStopRejected() public {
        (uint256[] memory pk, bytes memory sig) = _ethfalconSig();
        // right size, but the code starts with 0x01 instead of STOP
        bytes memory code = bytes.concat(hex"01", abi.encode(pk));
        assertEq(code.length, FALCON_PK_CODE_SIZE);
        address ptr = _deployRaw(code);
        assertEq(ptr.code.length, FALCON_PK_CODE_SIZE);
        vm.expectRevert(bytes("invalid public key"));
        ethfalcon.verify(abi.encodePacked(ptr), DIGEST, sig);
    }

    function test_L2_pointerWithNonCanonicalEncodingRejected() public {
        (uint256[] memory pk, bytes memory sig) = _ethfalconSig();
        // right size and STOP byte, written with SSTORE2 directly (bypassing setKey), non-canonical offset
        bytes memory enc = abi.encode(pk);
        enc[31] = 0x21;
        address ptr = SSTORE2.write(enc);
        vm.expectRevert(bytes("invalid public key"));
        ethfalcon.verify(abi.encodePacked(ptr), DIGEST, sig);
    }

    function test_L2_L3_pointerWithOutOfRangeKeyRejected() public {
        (uint256[] memory pk, bytes memory sig) = _ethfalconSig();
        // a key written with SSTORE2 directly (bypassing setKey) with ntth[0] + q: falcon_core rejects it
        uint256[] memory bad = _toDyn(_copy32(pk));
        _setCoeff(bad, 0, 0, _getCoeff(pk, 0, 0) + q);
        address ptr = SSTORE2.write(abi.encode(bad));
        assertEq(ethfalcon.verify(abi.encodePacked(ptr), DIGEST, sig), bytes4(0xFFFFFFFF));
    }

    // ------------------------------------------------------------------ I-2: no external self-call

    function test_I2_erc7913VerifyThroughDelegatecall() public {
        (uint256[] memory pk, bytes memory sig) = _ethfalconSig();
        bytes memory pubkey = ethfalcon.setKey(abi.encode(pk));
        // under DELEGATECALL, the former `this.verify(...)` resolved to the proxy, which has no such function
        ISigVerifier proxy = ISigVerifier(address(new DelegateProxy(address(ethfalcon))));
        assertEq(proxy.verify(pubkey, DIGEST, sig), ISigVerifier.verify.selector);
        sig[100] = sig[100] ^ bytes1(0x01);
        assertEq(proxy.verify(pubkey, DIGEST, sig), bytes4(0xFFFFFFFF));
    }

    // ------------------------------------------------------------------ L-11: decompress_KAT

    function test_L11_validKat() public pure {
        (bytes memory pk, bytes memory sm) = _katVector();
        (uint256[] memory h, uint256[] memory s2,, bytes memory message) = decompress_KAT(pk, sm, 33);
        assertEq(h.length, 512);
        assertEq(s2.length, 512);
        assertEq(message.length, 33);
    }

    function decodeKat(bytes memory pk, bytes memory sm, uint256 mlen) external pure {
        decompress_KAT(pk, sm, mlen);
    }

    function decodeBounded(bytes memory buf, uint256 offset, uint256 end) external pure {
        _decompress_sig_bounded(buf, offset, end);
    }

    function decodePadded(bytes memory buf, uint256 offset) external pure {
        _decompress_sig(buf, offset);
    }

    function _setSlen(bytes memory sm, uint256 slen) internal pure {
        sm[0] = bytes1(uint8(slen >> 8));
        sm[1] = bytes1(uint8(slen));
    }

    function _slen(bytes memory sm) internal pure returns (uint256) {
        return (uint256(uint8(sm[0])) << 8) | uint256(uint8(sm[1]));
    }

    function test_L11_trailingGarbageRejected() public {
        (bytes memory pk, bytes memory sm) = _katVector();
        // garbage appended, slen unchanged
        vm.expectRevert(bytes("invalid signature length"));
        this.decodeKat(pk, bytes.concat(sm, hex"00"), 33);
        vm.expectRevert(bytes("invalid signature length"));
        this.decodeKat(pk, bytes.concat(sm, hex"deadbeef"), 33);
        // garbage appended and covered by slen: the compressed s2 does not use it
        bytes memory longer = bytes.concat(sm, hex"00");
        _setSlen(longer, _slen(sm) + 1);
        vm.expectRevert(bytes("trailing bytes"));
        this.decodeKat(pk, longer, 33);
        // trailing byte after the public key
        vm.expectRevert(bytes("wrong public key encoding"));
        this.decodeKat(bytes.concat(pk, hex"00"), sm, 33);
    }

    function test_L11_badSlenRejected() public {
        (bytes memory pk, bytes memory sm) = _katVector();
        uint256[4] memory slens = [uint256(0), 0xffff, _slen(sm) - 1, _slen(sm) + 1];
        for (uint256 k = 0; k < 4; k++) {
            bytes memory bad = bytes.concat(sm);
            _setSlen(bad, slens[k]);
            vm.expectRevert(bytes("invalid signature length"));
            this.decodeKat(pk, bad, 33);
        }
        vm.expectRevert(bytes("invalid signature length"));
        this.decodeKat(pk, hex"00", 0);
    }

    function test_L11_truncatedSignatureRejected() public {
        (bytes memory pk, bytes memory sm) = _katVector();
        // drop the last byte and keep slen consistent: the decoder must stop at the end of the buffer
        bytes memory shorter = new bytes(sm.length - 1);
        for (uint256 i = 0; i < shorter.length; i++) {
            shorter[i] = sm[i];
        }
        _setSlen(shorter, _slen(sm) - 1);
        vm.expectRevert();
        this.decodeKat(pk, shorter, 33);
        // a buffer that ends in the middle of the polynomial
        vm.expectRevert(bytes("truncated signature"));
        this.decodeBounded(hex"0080", 0, 2);
        // `end` bounds reading even if the buffer is longer
        vm.expectRevert(bytes("truncated signature"));
        this.decodeBounded(bytes.concat(hex"0080", new bytes(700)), 0, 2);
    }

    function test_L11_nonZeroPaddingRejected() public {
        (bytes memory pk, bytes memory sm) = _katVector();
        // KAT 0 ends with 7 unused (zero) bits in its last byte 0x80
        assertEq(uint8(sm[sm.length - 1]), 0x80);
        sm[sm.length - 1] = 0x81;
        vm.expectRevert(bytes("non-zero padding"));
        this.decodeKat(pk, sm, 33);
    }

    function test_L11_minusZeroRejected() public {
        // first coefficient: sign = 1, low bits = 0, then the unary stop bit: "-0"
        vm.expectRevert(bytes("incorrect zero encoding"));
        this.decodeBounded(hex"8080", 0, 2);
        // "+0" is fine (and then the buffer is truncated)
        vm.expectRevert(bytes("truncated signature"));
        this.decodeBounded(hex"0080", 0, 2);
    }

    function test_L11_paddedFormatOnlyAllowsZeroTail() public {
        (, bytes memory sm) = _katVector();
        uint256 off = 2 + 40 + 33 + 1;
        // padded format: zero bytes after the polynomial are accepted
        this.decodePadded(bytes.concat(sm, new bytes(10)), off);
        vm.expectRevert(bytes("trailing bytes"));
        this.decodePadded(bytes.concat(sm, hex"0001"), off);
    }

    // ------------------------------------------------------------------ I-4: compact / expand

    function compact(uint256[] memory a) external pure returns (uint256[] memory) {
        return _ZKNOX_NTT_Compact(a);
    }

    function expand(uint256[] memory a) external pure returns (uint256[] memory) {
        return _ZKNOX_NTT_Expand(a);
    }

    function test_I4_compactMasksInputs() public pure {
        uint256[] memory a = new uint256[](512);
        a[0] = 0x10005; // 17 bits: must not spill into coefficient 1
        a[1] = 7;
        a[15] = type(uint256).max; // must not spill into the next word
        a[16] = 9;
        uint256[] memory b = _ZKNOX_NTT_Compact(a);
        assertEq(_getCoeff(b, 0, 0), 5);
        assertEq(_getCoeff(b, 0, 1), 7);
        assertEq(_getCoeff(b, 0, 15), 0xffff);
        assertEq(b[1], 9);
    }

    function test_I4_compactExpandLengthChecked() public {
        vm.expectRevert(bytes("invalid length"));
        this.compact(new uint256[](511));
        vm.expectRevert(bytes("invalid length"));
        this.compact(new uint256[](513));
        vm.expectRevert(bytes("invalid length"));
        this.expand(new uint256[](31));
        vm.expectRevert(bytes("invalid length"));
        this.expand(new uint256[](512));
    }

    // ------------------------------------------------------------------ I-4: SHAKE direction

    function shakeAbsorbAfterPad() external pure {
        CtxShake memory ctx;
        ctx = shakeUpdate(ctx, "abc");
        ctx = shakePad(ctx);
        shakeUpdate(ctx, "def");
    }

    function shakeSqueezeBeforePad() external pure {
        CtxShake memory ctx;
        ctx = shakeUpdate(ctx, "abc");
        shakeSqueeze(ctx, 32);
    }

    function shakeDoublePad() external pure {
        CtxShake memory ctx;
        ctx = shakeUpdate(ctx, "abc");
        ctx = shakePad(ctx);
        shakePad(ctx);
    }

    function test_I4_shakeDirectionEnforced() public {
        vm.expectRevert(bytes("SHAKE: absorb after squeeze"));
        this.shakeAbsorbAfterPad();
        vm.expectRevert(bytes("SHAKE: squeeze before pad"));
        this.shakeSqueezeBeforePad();
        vm.expectRevert(bytes("SHAKE: already padded"));
        this.shakeDoublePad();
    }

    function test_I4_shakeKnownAnswer() public pure {
        // SHAKE256("abc"), first 32 bytes
        CtxShake memory ctx;
        ctx = shakeUpdate(ctx, "abc");
        bytes memory out = shakeDigest(ctx, 32);
        assertEq(keccak256(out), keccak256(hex"483366601360a8771c6863080cc4114d8db44530f8f1e1ee4f94ea37e78b5739"));
    }

    // ------------------------------------------------------------------ I-4: hashToPointEVM allocation

    function test_I4_hashToPointEVMWritesNothingPastFreeMemory() public pure {
        (,, bytes memory salt) = _ethfalconVector();
        bytes memory message = abi.encodePacked(DIGEST);
        uint256[] memory h = hashToPointEVM(salt, message);
        // memory past the free memory pointer has never been written by this test: it must still be zero
        uint256 fmp;
        uint256 w0;
        uint256 w1;
        assembly {
            fmp := mload(0x40)
            w0 := mload(fmp)
            w1 := mload(add(fmp, 32))
        }
        assertEq(w0, 0, "hashToPointEVM wrote past the free memory pointer");
        assertEq(w1, 0, "hashToPointEVM wrote past the free memory pointer");
        assertEq(h.length, 512);
    }

    // ------------------------------------------------------------------ helpers

    function _copy32(uint256[] memory a) internal pure returns (uint256[32] memory b) {
        for (uint256 i = 0; i < 32; i++) {
            b[i] = a[i];
        }
    }

    function _deployRaw(bytes memory code) internal returns (address addr) {
        bytes memory init = abi.encodePacked(hex"63", uint32(code.length), hex"80600e6000396000f3", code);
        assembly {
            addr := create(0, add(init, 32), mload(init))
        }
        require(addr != address(0), "deploy failed");
    }
}
