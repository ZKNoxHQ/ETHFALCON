        // forward entries as in _f10FwW, the inverse ones 2,048 bytes further
        let t1 := add(tb, 256)
        let t2 := add(tb, 512)
        let t3 := add(tb, 1024)
        let kp := add(h, 32)
        let ks := 0
        for { let e := add(p, 0x1000) } lt(p, e) { p := add(p, 32) } {
            let W := mload(p)
            let V
            let lo
            let d
            V := mul(shr(128, W), shr(240, mload(t1)))
            V := shr(16, add(V, mul(and(mul(and(V, _F10_M16), 12287), _F10_M16), 12289)))
            lo := and(W, _F10_LO128)
            W := or(add(lo, V), shl(128, sub(add(lo, _F10_LOx5), V)))
            V := shr(224, mload(t2))
            lo := and(shr(64, W), _F10_M0145)
            V := or(and(mul(lo, shr(16, V)), _F10_M01), and(mul(lo, and(V, 0xffff)), _F10_M45))
            V := shr(16, add(V, mul(and(mul(and(V, _F10_M16), 12287), _F10_M16), 12289)))
            lo := and(W, _F10_M0145)
            W := or(add(lo, V), shl(64, sub(add(lo, _F10_0145x6), V)))
            W := sub(W, mul(and(shr(18, mul(W, 21)), _F10_Q5), 12289))
            V := shr(192, mload(t3))
            lo := and(shr(32, W), _F10_M0246)
            V := or(
                or(and(mul(lo, shr(48, V)), _F10_LN0), and(mul(lo, and(shr(32, V), 0xffff)), _F10_LN2)),
                or(and(mul(lo, and(shr(16, V), 0xffff)), _F10_LN4), and(mul(lo, and(V, 0xffff)), _F10_LN6))
            )
            V := shr(16, add(V, mul(and(mul(and(V, _F10_M16), 12287), _F10_M16), 12289)))
            lo := and(W, _F10_M0246)
            W := or(add(lo, V), shl(32, sub(add(lo, _F10_0246x2), V)))
            V := shr(ks, mload(kp))
            W := or(
                or(
                    or(and(mul(W, and(V, 0xffff)), _F10_LN0), and(mul(W, and(shr(16, V), 0xffff)), _F10_LN1)),
                    or(and(mul(W, and(shr(32, V), 0xffff)), _F10_LN2), and(mul(W, and(shr(48, V), 0xffff)), _F10_LN3))
                ),
                or(
                    or(and(mul(W, and(shr(64, V), 0xffff)), _F10_LN4), and(mul(W, and(shr(80, V), 0xffff)), _F10_LN5)),
                    or(and(mul(W, and(shr(96, V), 0xffff)), _F10_LN6), and(mul(W, and(shr(112, V), 0xffff)), _F10_LN7))
                )
            )
            W := shr(16, add(W, mul(and(mul(and(W, _F10_M16), 12287), _F10_M16), 12289)))
            V := shr(192, mload(add(t3, 2048)))
            lo := and(W, _F10_M0246)
            W := and(shr(32, W), _F10_M0246)
            d := sub(add(lo, _F10_0246x5), W)
            lo := add(lo, W)
            W := or(
                or(and(mul(d, shr(48, V)), _F10_LN0), and(mul(d, and(shr(32, V), 0xffff)), _F10_LN2)),
                or(and(mul(d, and(shr(16, V), 0xffff)), _F10_LN4), and(mul(d, and(V, 0xffff)), _F10_LN6))
            )
            W := shr(16, add(W, mul(and(mul(and(W, _F10_M16), 12287), _F10_M16), 12289)))
            W := or(lo, shl(32, W))
            V := shr(224, mload(add(t2, 2048)))
            lo := and(W, _F10_M0145)
            W := and(shr(64, W), _F10_M0145)
            d := sub(add(lo, _F10_0145x9), W)
            lo := add(lo, W)
            W := or(and(mul(d, shr(16, V)), _F10_M01), and(mul(d, and(V, 0xffff)), _F10_M45))
            W := shr(16, add(W, mul(and(mul(and(W, _F10_M16), 12287), _F10_M16), 12289)))
            W := or(lo, shl(64, W))
            W := sub(W, mul(and(shr(18, mul(W, 21)), _F10_Q5), 12289))
            V := shr(240, mload(add(t1, 2048)))
            lo := and(W, _F10_LO128)
            W := shr(128, W)
            d := mul(sub(add(lo, _F10_LOx2), W), V)
            lo := add(lo, W)
            d := shr(16, add(d, mul(and(mul(and(d, _F10_M16), 12287), _F10_M16), 12289)))
            W := or(lo, shl(128, d))
            mstore(p, W)
            t1 := add(t1, 2)
            t2 := add(t2, 4)
            t3 := add(t3, 8)
            kp := add(kp, shr(2, ks))
            ks := xor(ks, 128)
        }
    }
}

/// @dev inverse t = 8, 16, 32 of the product
function _f10ProdInvB(uint256[] memory A, uint256 tb) pure {
    assembly ("memory-safe") {
        let p := add(A, 32)
        let t1 := add(tb, 32)
        let t2 := add(tb, 64)
        let t3 := add(tb, 128)
        for { let e := add(p, 0x1000) } lt(p, e) { p := add(p, 0x100) } {
            let b0, b1, b2, b3
            {
                let u := mload(p)
                let v := mload(add(p, 0x20))
                let t := mul(sub(add(u, _F10_Q8x3), v), shr(240, mload(t3)))
                t := shr(16, add(t, mul(and(mul(and(t, _F10_M16), 12287), _F10_M16), 12289)))
                u := add(u, v)
                v := mload(add(p, 0x40))
                let w := mload(add(p, 0x60))
                let s := mul(sub(add(v, _F10_Q8x3), w), shr(240, mload(add(t3, 2))))
                s := shr(16, add(s, mul(and(mul(and(s, _F10_M16), 12287), _F10_M16), 12289)))
                v := add(v, w)
                w := mul(sub(add(u, _F10_Q8x5), v), shr(240, mload(t2)))
                w := shr(16, add(w, mul(and(mul(and(w, _F10_M16), 12287), _F10_M16), 12289)))
                b0 := add(u, v)
                b2 := w
                w := mul(sub(add(t, _F10_Q8x5), s), shr(240, mload(t2)))
                w := shr(16, add(w, mul(and(mul(and(w, _F10_M16), 12287), _F10_M16), 12289)))
                b1 := add(t, s)
                b3 := w
            }
            {
                let u := mload(add(p, 0x80))
                let v := mload(add(p, 0xa0))
                let t := mul(sub(add(u, _F10_Q8x3), v), shr(240, mload(add(t3, 4))))
                t := shr(16, add(t, mul(and(mul(and(t, _F10_M16), 12287), _F10_M16), 12289)))
                u := add(u, v)
                v := mload(add(p, 0xc0))
                let w := mload(add(p, 0xe0))
                let s := mul(sub(add(v, _F10_Q8x3), w), shr(240, mload(add(t3, 6))))
                s := shr(16, add(s, mul(and(mul(and(s, _F10_M16), 12287), _F10_M16), 12289)))
                v := add(v, w)
                w := mul(sub(add(u, _F10_Q8x5), v), shr(240, mload(add(t2, 2))))
                w := shr(16, add(w, mul(and(mul(and(w, _F10_M16), 12287), _F10_M16), 12289)))
                u := add(u, v)
                v := mul(sub(add(t, _F10_Q8x5), s), shr(240, mload(add(t2, 2))))
                v := shr(16, add(v, mul(and(mul(and(v, _F10_M16), 12287), _F10_M16), 12289)))
                t := add(t, s)
                s := mul(sub(add(b0, _F10_Q8x10), u), shr(240, mload(t1)))
                s := shr(16, add(s, mul(and(mul(and(s, _F10_M16), 12287), _F10_M16), 12289)))
                mstore(add(p, 0x80), s)
                b0 := add(b0, u)
                b0 := sub(b0, mul(and(shr(18, mul(b0, 21)), _F10_Q5), 12289))
                mstore(p, b0)
                s := mul(sub(add(b1, _F10_Q8x10), t), shr(240, mload(t1)))
                s := shr(16, add(s, mul(and(mul(and(s, _F10_M16), 12287), _F10_M16), 12289)))
                mstore(add(p, 0xa0), s)
                b1 := add(b1, t)
                b1 := sub(b1, mul(and(shr(18, mul(b1, 21)), _F10_Q5), 12289))
                mstore(add(p, 0x20), b1)
                s := mul(sub(add(b2, _F10_Q8x10), w), shr(240, mload(t1)))
                s := shr(16, add(s, mul(and(mul(and(s, _F10_M16), 12287), _F10_M16), 12289)))
                mstore(add(p, 0xc0), s)
