pragma solidity ^0.8.25;

import {Test} from "forge-std/Test.sol";
import "../src/ZKNOX_falcon.sol";

// Signatures produced by the @noble/post-quantum based signer (falcon/noble/zknox_falcon.mjs),
// regenerated by `node falcon/noble/gen_solidity_vectors.mjs`. The signer outputs the same
// encoding as the C signer (falcon.js): public key in the NTT domain, s2 as 16-bit words mod q,
// so s2 and ntth are only compacted, never transformed.
contract NobleSigner_Test is Test {
    ZKNOX_falcon falcon = new ZKNOX_falcon();

    function test_noble_vectors() public view {
        string memory json = vm.readFile(string.concat(vm.projectRoot(), "/test/noble_falcon_vectors.json"));
        uint256 n = 4;
        for (uint256 i = 0; i < n; i++) {
            string memory key = string.concat(".vectors[", vm.toString(i), "]");
            bytes memory message = vm.parseJsonBytes(json, string.concat(key, ".message"));
            bytes memory salt = vm.parseJsonBytes(json, string.concat(key, ".salt"));
            uint256[] memory s2 = vm.parseJsonUintArray(json, string.concat(key, ".s2"));
            uint256[] memory ntth = vm.parseJsonUintArray(json, string.concat(key, ".ntth"));

            assertTrue(falcon.verify(message, salt, s2, ntth), "noble signature rejected");

            // A different message must be rejected.
            bytes memory other = bytes.concat(message, hex"00");
            assertFalse(falcon.verify(other, salt, s2, ntth), "tampered message accepted");
        }
    }
}
