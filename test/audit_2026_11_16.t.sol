    /// @dev sets the 16-bit coefficient `lane` of compact word `word` to `value`
    function _setCoeff(uint256[] memory a, uint256 word, uint256 lane, uint256 value) internal pure {
        uint256 shift = lane * 16;
        a[word] = (a[word] & ~(uint256(0xffff) << shift)) | (value << shift);
    }

    function _getCoeff(uint256[] memory a, uint256 word, uint256 lane) internal pure returns (uint256) {
        return (a[word] >> (lane * 16)) & 0xffff;
    }

