                let lo := 0
                V := mul(shr(128, U), and(shr(96, mload(0)), 0xffff))
                V := sub(V, mul(and(shr(40, mul(V, 89471204)), _QHAT24), 12289))
                lo := and(U, _LO2)
                U := or(add(lo, V), shl(128, sub(add(lo, _Q2_01), V)))
                V := and(shr(64, U), _M02)
                V := or(and(mul(V, and(shr(64, w1), 0xffff)), _L64), and(mul(V, and(shr(80, w1), 0xffff)), _L2))
                V := sub(V, mul(and(shr(40, mul(V, 89471204)), _QHAT24), 12289))
                lo := and(U, _M02)
                U := or(add(lo, V), shl(64, sub(add(lo, _Q2_02), V)))
                mstore(p, U)
                V := mul(shr(128, X), and(shr(112, mload(0)), 0xffff))
                V := sub(V, mul(and(shr(40, mul(V, 89471204)), _QHAT24), 12289))
                lo := and(X, _LO2)
                X := or(add(lo, V), shl(128, sub(add(lo, _Q2_01), V)))
                V := and(shr(64, X), _M02)
                V := or(and(mul(V, and(shr(96, w1), 0xffff)), _L64), and(mul(V, and(shr(112, w1), 0xffff)), _L2))
                V := sub(V, mul(and(shr(40, mul(V, 89471204)), _QHAT24), 12289))
                lo := and(X, _M02)
                X := or(add(lo, V), shl(64, sub(add(lo, _Q2_02), V)))
                mstore(add(p, 32), X)
            }
            p := add(p, 64)
            {
                let U := mload(p)
                let V := mul(mload(add(p, 32)), and(shr(32, mload(0)), 0xffff))
                V := sub(V, mul(and(shr(40, mul(V, 89471204)), _QHAT24), 12289))
                let X := sub(add(U, _Q4_2), V)
                U := add(U, V)
                let lo := 0
                V := mul(shr(128, U), and(shr(128, mload(0)), 0xffff))
                V := sub(V, mul(and(shr(40, mul(V, 89471204)), _QHAT24), 12289))
                lo := and(U, _LO2)
                U := or(add(lo, V), shl(128, sub(add(lo, _Q2_01), V)))
                V := and(shr(64, U), _M02)
                V := or(and(mul(V, and(shr(128, w1), 0xffff)), _L64), and(mul(V, and(shr(144, w1), 0xffff)), _L2))
                V := sub(V, mul(and(shr(40, mul(V, 89471204)), _QHAT24), 12289))
                lo := and(U, _M02)
                U := or(add(lo, V), shl(64, sub(add(lo, _Q2_02), V)))
                mstore(p, U)
                V := mul(shr(128, X), and(shr(144, mload(0)), 0xffff))
                V := sub(V, mul(and(shr(40, mul(V, 89471204)), _QHAT24), 12289))
                lo := and(X, _LO2)
                X := or(add(lo, V), shl(128, sub(add(lo, _Q2_01), V)))
                V := and(shr(64, X), _M02)
                V := or(and(mul(V, and(shr(160, w1), 0xffff)), _L64), and(mul(V, and(shr(176, w1), 0xffff)), _L2))
                V := sub(V, mul(and(shr(40, mul(V, 89471204)), _QHAT24), 12289))
                lo := and(X, _M02)
                X := or(add(lo, V), shl(64, sub(add(lo, _Q2_02), V)))
                mstore(add(p, 32), X)
            }
            p := add(p, 64)
            {
                let U := mload(p)
                let V := mul(mload(add(p, 32)), and(shr(48, mload(0)), 0xffff))
                V := sub(V, mul(and(shr(40, mul(V, 89471204)), _QHAT24), 12289))
                let X := sub(add(U, _Q4_2), V)
                U := add(U, V)
                let lo := 0
                V := mul(shr(128, U), and(shr(160, mload(0)), 0xffff))
                V := sub(V, mul(and(shr(40, mul(V, 89471204)), _QHAT24), 12289))
                lo := and(U, _LO2)
                U := or(add(lo, V), shl(128, sub(add(lo, _Q2_01), V)))
                V := and(shr(64, U), _M02)
                V := or(and(mul(V, and(shr(192, w1), 0xffff)), _L64), and(mul(V, and(shr(208, w1), 0xffff)), _L2))
                V := sub(V, mul(and(shr(40, mul(V, 89471204)), _QHAT24), 12289))
                lo := and(U, _M02)
                U := or(add(lo, V), shl(64, sub(add(lo, _Q2_02), V)))
                mstore(p, U)
                V := mul(shr(128, X), and(shr(176, mload(0)), 0xffff))
                V := sub(V, mul(and(shr(40, mul(V, 89471204)), _QHAT24), 12289))
                lo := and(X, _LO2)
                X := or(add(lo, V), shl(128, sub(add(lo, _Q2_01), V)))
                V := and(shr(64, X), _M02)
                V := or(and(mul(V, and(shr(224, w1), 0xffff)), _L64), and(mul(V, and(shr(240, w1), 0xffff)), _L2))
                V := sub(V, mul(and(shr(40, mul(V, 89471204)), _QHAT24), 12289))
                lo := and(X, _M02)
                X := or(add(lo, V), shl(64, sub(add(lo, _Q2_02), V)))
                mstore(add(p, 32), X)
            }
            p := add(p, 64)
        }
    }
}

/// @notice Forward NTT of a compact polynomial (32 words x 16 coefficients of
///         16 bits, every coefficient < q). Returns 128 packed words with LAZY
///         lanes (< 19q), congruent lane-wise to _nttFwPacked(_packFromCompact(c)).
function _nttFwFused(uint256[] memory c) pure returns (uint256[] memory A) {
    A = _fwPassA(c);
    uint256 tb = _fwTableFused();
    _fwPassB(A, tb);
    _fwPassC(A, tb);
}

/// @dev Inverse pass C': per word, lanes to scalars, pointwise product with
///      the public key (mulmod, exact), t = 1 and t = 2 in-word, then t = 4
///      on the pair (2j, 2j+1). Output lanes < 2q. Pair j reads the 64-bit
///      chunk (j & 1) of compact pk word j >> 1 (eight coefficients).
function _invPassC(uint256[] memory A, uint256[] memory pk, uint256 tb) pure {
    assembly ("memory-safe") {
        let p := add(A, 32)
        for { let i1 := 0 } lt(i1, 16) { i1 := add(i1, 1) } {
            mstore(
                0,
                or(
                    and(shr(shl(6, and(i1, 3)), mload(add(tb, add(128, shl(5, shr(2, i1)))))), _L64),
                    shl(64, shr(shl(7, and(i1, 1)), mload(add(tb, add(256, shl(5, shr(1, i1)))))))
                )
            )
            let w1 := mload(add(tb, add(512, shl(5, i1))))
            {
                let c := mload(add(pk, add(32, shl(6, i1))))
                {
                    let W := mload(p)
                    let l0 := mulmod(and(W, _L64), and(c, 0xffff), 12289)
                    let l1 := mulmod(and(shr(64, W), _L64), and(shr(16, c), 0xffff), 12289)
                    let l2 := mulmod(and(shr(128, W), _L64), and(shr(32, c), 0xffff), 12289)
                    let l3 := mulmod(shr(192, W), and(shr(48, c), 0xffff), 12289)
                    // t = 1: s = a + b (< 2q), d = (a + q - b) S = (s + q - 2b) S
                    l0 := add(l0, l1)
                    l1 := mulmod(sub(add(l0, 12289), shl(1, l1)), and(w1, 0xffff), 12289)
                    l2 := add(l2, l3)
                    l3 := mulmod(sub(add(l2, 12289), shl(1, l3)), and(shr(16, w1), 0xffff), 12289)
                    // t = 2: (s0, d0) against (s1, d1)
                    W := and(shr(64, mload(0)), 0xffff)
                    l3 := or(shl(64, addmod(l1, l3, 12289)), shl(192, mulmod(sub(add(l1, 12289), l3), W, 12289)))
                    l1 := or(mod(add(l0, l2), 12289), shl(128, mulmod(sub(add(l0, 24578), l2), W, 12289)))
                    mstore(p, or(l1, l3))
                }
                {
                    let W := mload(add(p, 32))
                    let l0 := mulmod(and(W, _L64), and(shr(64, c), 0xffff), 12289)
                    let l1 := mulmod(and(shr(64, W), _L64), and(shr(16, shr(64, c)), 0xffff), 12289)
                    let l2 := mulmod(and(shr(128, W), _L64), and(shr(32, shr(64, c)), 0xffff), 12289)
                    let l3 := mulmod(shr(192, W), and(shr(48, shr(64, c)), 0xffff), 12289)
                    // t = 1: s = a + b (< 2q), d = (a + q - b) S = (s + q - 2b) S
                    l0 := add(l0, l1)
                    l1 := mulmod(sub(add(l0, 12289), shl(1, l1)), and(shr(32, w1), 0xffff), 12289)
                    l2 := add(l2, l3)
                    l3 := mulmod(sub(add(l2, 12289), shl(1, l3)), and(shr(48, w1), 0xffff), 12289)
                    // t = 2: (s0, d0) against (s1, d1)
                    W := and(shr(80, mload(0)), 0xffff)
                    l3 := or(shl(64, addmod(l1, l3, 12289)), shl(192, mulmod(sub(add(l1, 12289), l3), W, 12289)))
                    l1 := or(mod(add(l0, l2), 12289), shl(128, mulmod(sub(add(l0, 24578), l2), W, 12289)))
                    mstore(add(p, 32), or(l1, l3))
                }
                {
                    // t = 4 (GS): (U, V) -> (U + V, red((U + q - V) * S)), lanes < 2q
                    let U := mload(p)
                    let V := mload(add(p, 32))
                    mstore(p, add(U, V))
                    V := mul(sub(add(U, _Q4_1), V), and(mload(0), 0xffff))
                    V := sub(V, mul(and(shr(40, mul(V, 89471204)), _QHAT24), 12289))
                    mstore(add(p, 32), V)
                }
            }
            p := add(p, 64)
            {
                let c := shr(128, mload(add(pk, add(32, shl(6, i1)))))
                {
                    let W := mload(p)
                    let l0 := mulmod(and(W, _L64), and(c, 0xffff), 12289)
                    let l1 := mulmod(and(shr(64, W), _L64), and(shr(16, c), 0xffff), 12289)
                    let l2 := mulmod(and(shr(128, W), _L64), and(shr(32, c), 0xffff), 12289)
                    let l3 := mulmod(shr(192, W), and(shr(48, c), 0xffff), 12289)
                    // t = 1: s = a + b (< 2q), d = (a + q - b) S = (s + q - 2b) S
                    l0 := add(l0, l1)
                    l1 := mulmod(sub(add(l0, 12289), shl(1, l1)), and(shr(64, w1), 0xffff), 12289)
                    l2 := add(l2, l3)
                    l3 := mulmod(sub(add(l2, 12289), shl(1, l3)), and(shr(80, w1), 0xffff), 12289)
                    // t = 2: (s0, d0) against (s1, d1)
                    W := and(shr(96, mload(0)), 0xffff)
                    l3 := or(shl(64, addmod(l1, l3, 12289)), shl(192, mulmod(sub(add(l1, 12289), l3), W, 12289)))
                    l1 := or(mod(add(l0, l2), 12289), shl(128, mulmod(sub(add(l0, 24578), l2), W, 12289)))
                    mstore(p, or(l1, l3))
                }
                {
                    let W := mload(add(p, 32))
                    let l0 := mulmod(and(W, _L64), and(shr(64, c), 0xffff), 12289)
                    let l1 := mulmod(and(shr(64, W), _L64), and(shr(16, shr(64, c)), 0xffff), 12289)
                    let l2 := mulmod(and(shr(128, W), _L64), and(shr(32, shr(64, c)), 0xffff), 12289)
                    let l3 := mulmod(shr(192, W), and(shr(48, shr(64, c)), 0xffff), 12289)
                    // t = 1: s = a + b (< 2q), d = (a + q - b) S = (s + q - 2b) S
                    l0 := add(l0, l1)
                    l1 := mulmod(sub(add(l0, 12289), shl(1, l1)), and(shr(96, w1), 0xffff), 12289)
                    l2 := add(l2, l3)
                    l3 := mulmod(sub(add(l2, 12289), shl(1, l3)), and(shr(112, w1), 0xffff), 12289)
                    // t = 2: (s0, d0) against (s1, d1)
                    W := and(shr(112, mload(0)), 0xffff)
                    l3 := or(shl(64, addmod(l1, l3, 12289)), shl(192, mulmod(sub(add(l1, 12289), l3), W, 12289)))
                    l1 := or(mod(add(l0, l2), 12289), shl(128, mulmod(sub(add(l0, 24578), l2), W, 12289)))
                    mstore(add(p, 32), or(l1, l3))
                }
                {
                    // t = 4 (GS): (U, V) -> (U + V, red((U + q - V) * S)), lanes < 2q
                    let U := mload(p)
                    let V := mload(add(p, 32))
                    mstore(p, add(U, V))
                    V := mul(sub(add(U, _Q4_1), V), and(shr(16, mload(0)), 0xffff))
                    V := sub(V, mul(and(shr(40, mul(V, 89471204)), _QHAT24), 12289))
                    mstore(add(p, 32), V)
                }
            }
            p := add(p, 64)
            {
                let c := mload(add(pk, add(64, shl(6, i1))))
                {
                    let W := mload(p)
                    let l0 := mulmod(and(W, _L64), and(c, 0xffff), 12289)
                    let l1 := mulmod(and(shr(64, W), _L64), and(shr(16, c), 0xffff), 12289)
                    let l2 := mulmod(and(shr(128, W), _L64), and(shr(32, c), 0xffff), 12289)
                    let l3 := mulmod(shr(192, W), and(shr(48, c), 0xffff), 12289)
                    // t = 1: s = a + b (< 2q), d = (a + q - b) S = (s + q - 2b) S
                    l0 := add(l0, l1)
                    l1 := mulmod(sub(add(l0, 12289), shl(1, l1)), and(shr(128, w1), 0xffff), 12289)
                    l2 := add(l2, l3)
                    l3 := mulmod(sub(add(l2, 12289), shl(1, l3)), and(shr(144, w1), 0xffff), 12289)
                    // t = 2: (s0, d0) against (s1, d1)
                    W := and(shr(128, mload(0)), 0xffff)
                    l3 := or(shl(64, addmod(l1, l3, 12289)), shl(192, mulmod(sub(add(l1, 12289), l3), W, 12289)))
                    l1 := or(mod(add(l0, l2), 12289), shl(128, mulmod(sub(add(l0, 24578), l2), W, 12289)))
                    mstore(p, or(l1, l3))
                }
                {
                    let W := mload(add(p, 32))
                    let l0 := mulmod(and(W, _L64), and(shr(64, c), 0xffff), 12289)
                    let l1 := mulmod(and(shr(64, W), _L64), and(shr(16, shr(64, c)), 0xffff), 12289)
                    let l2 := mulmod(and(shr(128, W), _L64), and(shr(32, shr(64, c)), 0xffff), 12289)
                    let l3 := mulmod(shr(192, W), and(shr(48, shr(64, c)), 0xffff), 12289)
                    // t = 1: s = a + b (< 2q), d = (a + q - b) S = (s + q - 2b) S
                    l0 := add(l0, l1)
                    l1 := mulmod(sub(add(l0, 12289), shl(1, l1)), and(shr(160, w1), 0xffff), 12289)
                    l2 := add(l2, l3)
                    l3 := mulmod(sub(add(l2, 12289), shl(1, l3)), and(shr(176, w1), 0xffff), 12289)
                    // t = 2: (s0, d0) against (s1, d1)
                    W := and(shr(144, mload(0)), 0xffff)
                    l3 := or(shl(64, addmod(l1, l3, 12289)), shl(192, mulmod(sub(add(l1, 12289), l3), W, 12289)))
                    l1 := or(mod(add(l0, l2), 12289), shl(128, mulmod(sub(add(l0, 24578), l2), W, 12289)))
                    mstore(add(p, 32), or(l1, l3))
                }
                {
                    // t = 4 (GS): (U, V) -> (U + V, red((U + q - V) * S)), lanes < 2q
                    let U := mload(p)
                    let V := mload(add(p, 32))
                    mstore(p, add(U, V))
                    V := mul(sub(add(U, _Q4_1), V), and(shr(32, mload(0)), 0xffff))
                    V := sub(V, mul(and(shr(40, mul(V, 89471204)), _QHAT24), 12289))
                    mstore(add(p, 32), V)
                }
            }
            p := add(p, 64)
            {
                let c := shr(128, mload(add(pk, add(64, shl(6, i1)))))
                {
                    let W := mload(p)
                    let l0 := mulmod(and(W, _L64), and(c, 0xffff), 12289)
                    let l1 := mulmod(and(shr(64, W), _L64), and(shr(16, c), 0xffff), 12289)
                    let l2 := mulmod(and(shr(128, W), _L64), and(shr(32, c), 0xffff), 12289)
                    let l3 := mulmod(shr(192, W), and(shr(48, c), 0xffff), 12289)
                    // t = 1: s = a + b (< 2q), d = (a + q - b) S = (s + q - 2b) S
                    l0 := add(l0, l1)
                    l1 := mulmod(sub(add(l0, 12289), shl(1, l1)), and(shr(192, w1), 0xffff), 12289)
                    l2 := add(l2, l3)
                    l3 := mulmod(sub(add(l2, 12289), shl(1, l3)), and(shr(208, w1), 0xffff), 12289)
                    // t = 2: (s0, d0) against (s1, d1)
                    W := and(shr(160, mload(0)), 0xffff)
                    l3 := or(shl(64, addmod(l1, l3, 12289)), shl(192, mulmod(sub(add(l1, 12289), l3), W, 12289)))
                    l1 := or(mod(add(l0, l2), 12289), shl(128, mulmod(sub(add(l0, 24578), l2), W, 12289)))
                    mstore(p, or(l1, l3))
                }
                {
                    let W := mload(add(p, 32))
                    let l0 := mulmod(and(W, _L64), and(shr(64, c), 0xffff), 12289)
                    let l1 := mulmod(and(shr(64, W), _L64), and(shr(16, shr(64, c)), 0xffff), 12289)
                    let l2 := mulmod(and(shr(128, W), _L64), and(shr(32, shr(64, c)), 0xffff), 12289)
                    let l3 := mulmod(shr(192, W), and(shr(48, shr(64, c)), 0xffff), 12289)
                    // t = 1: s = a + b (< 2q), d = (a + q - b) S = (s + q - 2b) S
                    l0 := add(l0, l1)
                    l1 := mulmod(sub(add(l0, 12289), shl(1, l1)), and(shr(224, w1), 0xffff), 12289)
                    l2 := add(l2, l3)
                    l3 := mulmod(sub(add(l2, 12289), shl(1, l3)), and(shr(240, w1), 0xffff), 12289)
                    // t = 2: (s0, d0) against (s1, d1)
                    W := and(shr(176, mload(0)), 0xffff)
                    l3 := or(shl(64, addmod(l1, l3, 12289)), shl(192, mulmod(sub(add(l1, 12289), l3), W, 12289)))
                    l1 := or(mod(add(l0, l2), 12289), shl(128, mulmod(sub(add(l0, 24578), l2), W, 12289)))
                    mstore(add(p, 32), or(l1, l3))
                }
                {
                    // t = 4 (GS): (U, V) -> (U + V, red((U + q - V) * S)), lanes < 2q
                    let U := mload(p)
                    let V := mload(add(p, 32))
                    mstore(p, add(U, V))
                    V := mul(sub(add(U, _Q4_1), V), and(shr(48, mload(0)), 0xffff))
                    V := sub(V, mul(and(shr(40, mul(V, 89471204)), _QHAT24), 12289))
                    mstore(add(p, 32), V)
                }
            }
            p := add(p, 64)
        }
    }
}

/// @dev Inverse pass B': t = 8, 16, 32 on the octets (16b + r, +2, ..., +14).
///      Sums are never reduced: lanes < 2q in, < 16q out.
function _invPassB(uint256[] memory A, uint256 tb) pure {
    assembly ("memory-safe") {
        for { let b := 0 } lt(b, 8) { b := add(b, 1) } {
            {
                let w := mload(add(tb, add(64, shl(5, shr(2, b)))))
                mstore(
                    0,
                    or(
                        or(
                            and(shr(shl(4, add(8, b)), mload(tb)), 0xffff),
                            shl(16, and(shr(shl(5, b), mload(add(tb, 32))), 0xffffffff))
                        ),
                        shl(48, and(shr(shl(6, and(b, 3)), w), _L64))
                    )
                )
            }
            let p := add(add(A, 32), shl(9, b))
            for { let r := 0 } lt(r, 2) { r := add(r, 1) } {
                let b0, b1, b2, b3
                {
                    let u := mload(p)
                    let v := mload(add(p, 0x40))
                    let t := mul(sub(add(u, _Q4_2), v), and(shr(48, mload(0)), 0xffff))
                    t := sub(t, mul(and(shr(40, mul(t, 89471204)), _QHAT24), 12289))
                    u := add(u, v)
                    v := mload(add(p, 0x80))
                    let w := mload(add(p, 0xc0))
                    let s := mul(sub(add(v, _Q4_2), w), and(shr(64, mload(0)), 0xffff))
                    s := sub(s, mul(and(shr(40, mul(s, 89471204)), _QHAT24), 12289))
                    v := add(v, w)
                    w := mul(sub(add(u, _Q4_4), v), and(shr(16, mload(0)), 0xffff))
                    w := sub(w, mul(and(shr(40, mul(w, 89471204)), _QHAT24), 12289))
                    b0 := add(u, v)
                    b2 := w
                    w := mul(sub(add(t, _Q4_4), s), and(shr(16, mload(0)), 0xffff))
                    w := sub(w, mul(and(shr(40, mul(w, 89471204)), _QHAT24), 12289))
                    b1 := add(t, s)
                    b3 := w
                }
                {
                    let u := mload(add(p, 0x100))
                    let v := mload(add(p, 0x140))
                    let t := mul(sub(add(u, _Q4_2), v), and(shr(80, mload(0)), 0xffff))
                    t := sub(t, mul(and(shr(40, mul(t, 89471204)), _QHAT24), 12289))
                    u := add(u, v)
                    v := mload(add(p, 0x180))
                    let w := mload(add(p, 0x1c0))
                    let s := mul(sub(add(v, _Q4_2), w), and(shr(96, mload(0)), 0xffff))
                    s := sub(s, mul(and(shr(40, mul(s, 89471204)), _QHAT24), 12289))
                    v := add(v, w)
                    w := mul(sub(add(u, _Q4_4), v), and(shr(32, mload(0)), 0xffff))
                    w := sub(w, mul(and(shr(40, mul(w, 89471204)), _QHAT24), 12289))
                    u := add(u, v)
                    v := mul(sub(add(t, _Q4_4), s), and(shr(32, mload(0)), 0xffff))
                    v := sub(v, mul(and(shr(40, mul(v, 89471204)), _QHAT24), 12289))
                    t := add(t, s)
                    s := mul(sub(add(b0, _Q4_8), u), and(mload(0), 0xffff))
                    s := sub(s, mul(and(shr(40, mul(s, 89471204)), _QHAT24), 12289))
                    mstore(add(p, 0x100), s)
                    mstore(p, add(b0, u))
                    s := mul(sub(add(b1, _Q4_8), t), and(mload(0), 0xffff))
                    s := sub(s, mul(and(shr(40, mul(s, 89471204)), _QHAT24), 12289))
                    mstore(add(p, 0x140), s)
                    mstore(add(p, 0x40), add(b1, t))
                    s := mul(sub(add(b2, _Q4_8), w), and(mload(0), 0xffff))
                    s := sub(s, mul(and(shr(40, mul(s, 89471204)), _QHAT24), 12289))
                    mstore(add(p, 0x180), s)
                    mstore(add(p, 0x80), add(b2, w))
                    s := mul(sub(add(b3, _Q4_8), v), and(mload(0), 0xffff))
                    s := sub(s, mul(and(shr(40, mul(s, 89471204)), _QHAT24), 12289))
                    mstore(add(p, 0x1c0), s)
                    mstore(add(p, 0xc0), add(b3, v))
                }
                p := add(p, 32)
            }
        }
    }
}

/// @dev Inverse pass A': t = 64, 128, 256 on the octet (i, i+16, ..., i+112)
///      with n^-1 folded into the last layer (psirev[1] * n^-1 is a literal);
///      every output lane canonical (< q).
function _invPassA(uint256[] memory A) pure {
    assembly ("memory-safe") {
        for { let i := 0 } lt(i, 16) { i := add(i, 1) } {
            let p := add(add(A, 32), shl(5, i))
            let b0, b1, b2, b3
            {
                let u := mload(p)
                let v := mload(add(p, 0x200))
                let t := mul(sub(add(u, _Q4_16), v), 0x1026)
                t := sub(t, mul(and(shr(40, mul(t, 89471204)), _QHAT24), 12289))
                u := add(u, v)
                v := mload(add(p, 0x400))
                let w := mload(add(p, 0x600))
                let s := mul(sub(add(v, _Q4_16), w), 0x1999)
                s := sub(s, mul(and(shr(40, mul(s, 89471204)), _QHAT24), 12289))
                v := add(v, w)
                w := mul(sub(add(u, _Q4_32), v), 0x2036)
                w := sub(w, mul(and(shr(40, mul(w, 89471204)), _QHAT24), 12289))
                b0 := add(u, v)
                b2 := w
                w := mul(sub(add(t, _Q4_32), s), 0x2036)
                w := sub(w, mul(and(shr(40, mul(w, 89471204)), _QHAT24), 12289))
                b1 := add(t, s)
                b3 := w
            }
            {
                let u := mload(add(p, 0x800))
                let v := mload(add(p, 0xa00))
                let t := mul(sub(add(u, _Q4_16), v), 0x2d2f)
                t := sub(t, mul(and(shr(40, mul(t, 89471204)), _QHAT24), 12289))
                u := add(u, v)
                v := mload(add(p, 0xc00))
                let w := mload(add(p, 0xe00))
                let s := mul(sub(add(v, _Q4_16), w), 0x519)
                s := sub(s, mul(and(shr(40, mul(s, 89471204)), _QHAT24), 12289))
                v := add(v, w)
                w := mul(sub(add(u, _Q4_32), v), 0x141a)
                w := sub(w, mul(and(shr(40, mul(w, 89471204)), _QHAT24), 12289))
                u := add(u, v)
                v := mul(sub(add(t, _Q4_32), s), 0x141a)
                v := sub(v, mul(and(shr(40, mul(v, 89471204)), _QHAT24), 12289))
                t := add(t, s)
                s := mul(sub(add(b0, _Q4_64), u), 0x55b)
                s := sub(s, mul(and(shr(40, mul(s, 89471204)), _QHAT24), 12289))
                s := sub(s, mul(shr(14, and(add(s, _C14), _H14)), 12289))
                mstore(add(p, 0x800), s)
                s := mul(add(b0, u), 12265)
                s := sub(s, mul(and(shr(40, mul(s, 89471204)), _QHAT24), 12289))
                s := sub(s, mul(shr(14, and(add(s, _C14), _H14)), 12289))
                mstore(p, s)
                s := mul(sub(add(b1, _Q4_64), t), 0x55b)
                s := sub(s, mul(and(shr(40, mul(s, 89471204)), _QHAT24), 12289))
                s := sub(s, mul(shr(14, and(add(s, _C14), _H14)), 12289))
                mstore(add(p, 0xa00), s)
                s := mul(add(b1, t), 12265)
                s := sub(s, mul(and(shr(40, mul(s, 89471204)), _QHAT24), 12289))
                s := sub(s, mul(shr(14, and(add(s, _C14), _H14)), 12289))
                mstore(add(p, 0x200), s)
                s := mul(sub(add(b2, _Q4_64), w), 0x55b)
                s := sub(s, mul(and(shr(40, mul(s, 89471204)), _QHAT24), 12289))
                s := sub(s, mul(shr(14, and(add(s, _C14), _H14)), 12289))
                mstore(add(p, 0xc00), s)
                s := mul(add(b2, w), 12265)
                s := sub(s, mul(and(shr(40, mul(s, 89471204)), _QHAT24), 12289))
                s := sub(s, mul(shr(14, and(add(s, _C14), _H14)), 12289))
                mstore(add(p, 0x400), s)
                s := mul(sub(add(b3, _Q4_64), v), 0x55b)
                s := sub(s, mul(and(shr(40, mul(s, 89471204)), _QHAT24), 12289))
                s := sub(s, mul(shr(14, and(add(s, _C14), _H14)), 12289))
                mstore(add(p, 0xe00), s)
                s := mul(add(b3, v), 12265)
                s := sub(s, mul(and(shr(40, mul(s, 89471204)), _QHAT24), 12289))
                s := sub(s, mul(shr(14, and(add(s, _C14), _H14)), 12289))
                mstore(add(p, 0x600), s)
            }
        }
    }
}

/// @notice Pointwise product with the compact public key (32 words x 16
///         coefficients of 16 bits, every coefficient < q) followed by the
///         inverse NTT, in place on the 128 packed words A. Input lanes may be
///         lazy (any value < 2^64). Output lanes are CANONICAL (< q) and equal,
///         lane-wise, to _nttInvPacked(_vecMulPacked(A, _packFromCompact(pk)))
///         reduced mod q.
function _nttInvFusedMul(uint256[] memory A, uint256[] memory pk) pure returns (uint256[] memory) {
    uint256 tb = _invTableFused();
    _invPassC(A, pk, tb);
    _invPassB(A, tb);
    _invPassA(A);
    return A;
}

uint256 constant _Q16 = 0x3001300130013001300130013001300130013001300130013001300130013001;
uint256 constant _CAN16 = 0x4fff4fff4fff4fff4fff4fff4fff4fff4fff4fff4fff4fff4fff4fff4fff4fff;
uint256 constant _CEN16 = 0x67ff67ff67ff67ff67ff67ff67ff67ff67ff67ff67ff67ff67ff67ff67ff67ff;
uint256 constant _H16 = 0x8000800080008000800080008000800080008000800080008000800080008000;
uint256 constant _M64LO = 0x0000000000000000ffffffffffffffff0000000000000000ffffffffffffffff;
uint256 constant _M64HI = 0xffffffffffffffff0000000000000000ffffffffffffffff0000000000000000;
uint256 constant _M32LO = 0x00000000ffffffff00000000ffffffff00000000ffffffff00000000ffffffff;
uint256 constant _M32HI = 0xffffffff00000000ffffffff00000000ffffffff00000000ffffffff00000000;
uint256 constant _M16LO = 0x0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff;
uint256 constant _M16HI = 0xffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000;

/// @notice Range check and centred squared norm of a compact polynomial (32
///         words x 16 coefficients of 16 bits). outOfRange != 0 iff some
///         coefficient is >= q; norm = sum of min(v, q - v)^2, as in
///         falcon_normalize (meaningful only when outOfRange == 0).
function _s2NormCompact(uint256[] memory c) pure returns (uint256 outOfRange, uint256 norm) {
    assembly ("memory-safe") {
        let p := add(c, 32)
        let pe := add(p, 1024)
        for {} lt(p, pe) { p := add(p, 32) } {
            let v := mload(p)
            // v >= q  <=>  bit 15 or bit 14 of v, or bit 14 of ((v & 0x3fff) + 2^14 - q)
            outOfRange := or(outOfRange, and(v, 0xc000c000c000c000c000c000c000c000c000c000c000c000c000c000c000c000))
            outOfRange := or(
                outOfRange,
                and(
                    add(
                        and(v, 0x3fff3fff3fff3fff3fff3fff3fff3fff3fff3fff3fff3fff3fff3fff3fff3fff),
                        0x0fff0fff0fff0fff0fff0fff0fff0fff0fff0fff0fff0fff0fff0fff0fff0fff
                    ),
                    0x4000400040004000400040004000400040004000400040004000400040004000
                )
            )
            let f := 0
            // centre: fields with v > q/2 take q - v
            f := and(add(v, _CEN16), _H16)
            f := or(f, sub(f, shr(15, f)))
            v := xor(v, and(f, xor(v, sub(_Q16, v))))
            // reverse the sixteen fields
            f := or(shl(128, v), shr(128, v))
            f := or(shl(64, and(f, _M64LO)), shr(64, and(f, _M64HI)))
            f := or(shl(32, and(f, _M32LO)), shr(32, and(f, _M32HI)))
            f := or(shl(16, and(f, _M16LO)), shr(16, and(f, _M16HI)))
            // even fields against reversed even fields, odd against reversed odd
            norm := add(norm, shr(224, mul(and(v, _M16LO), and(shr(16, f), _M16LO))))
            norm := add(norm, shr(224, mul(and(shr(16, v), _M16LO), and(f, _M16LO))))
        }
    }
}

/// @notice Centred squared norm of h - s (mod q) over 512 coefficients given
///         as 128 packed words each (4 canonical 64-bit lanes per word), i.e.
///         the ||s1||^2 half of falcon_normalize with s1 = h - s.
function _normS1Packed(uint256[] memory h, uint256[] memory s) pure returns (uint256 norm) {
    assembly ("memory-safe") {
        let ph := add(h, 32)
        let ps := add(s, 32)
        let pe := add(ph, 4096)
        for {} lt(ph, pe) {
            ph := add(ph, 128)
            ps := add(ps, 128)
        } {
            // four words of lanes h + q - s (< 2q < 2^15) interleaved into one
            // word of sixteen 16-bit fields (the order does not matter here)
            let v := sub(add(mload(ph), _Q4_1), mload(ps))
            v := or(v, shl(16, sub(add(mload(add(ph, 32)), _Q4_1), mload(add(ps, 32)))))
            v := or(v, shl(32, sub(add(mload(add(ph, 64)), _Q4_1), mload(add(ps, 64)))))
            v := or(v, shl(48, sub(add(mload(add(ph, 96)), _Q4_1), mload(add(ps, 96)))))
            // canonicalise: fields >= q lose q
            let f := and(add(v, _CAN16), _H16)
            v := sub(v, mul(shr(15, f), 12289))
            // centre: fields with v > q/2 take q - v
            f := and(add(v, _CEN16), _H16)
            f := or(f, sub(f, shr(15, f)))
            v := xor(v, and(f, xor(v, sub(_Q16, v))))
            // reverse the sixteen fields
            f := or(shl(128, v), shr(128, v))
            f := or(shl(64, and(f, _M64LO)), shr(64, and(f, _M64HI)))
            f := or(shl(32, and(f, _M32LO)), shr(32, and(f, _M32HI)))
            f := or(shl(16, and(f, _M16LO)), shr(16, and(f, _M16HI)))
            // even fields against reversed even fields, odd against reversed odd
            norm := add(norm, shr(224, mul(and(v, _M16LO), and(shr(16, f), _M16LO))))
            norm := add(norm, shr(224, mul(and(shr(16, v), _M16LO), and(f, _M16LO))))
        }
    }
}
