                X := or(add(lo, V), shl(128, sub(add(lo, _Q2_01), V)))
                V := and(shr(64, X), _M02)
                V := or(and(mul(V, and(shr(32, w1), 0xffff)), _L64), and(mul(V, and(shr(48, w1), 0xffff)), _L2))
                V := sub(V, mul(and(shr(40, mul(V, 89471204)), _QHAT24), 12289))
                lo := and(X, _M02)
                X := or(add(lo, V), shl(64, sub(add(lo, _Q2_02), V)))
                mstore(add(p, 32), X)
            }
            p := add(p, 64)
            {
                let U := mload(p)
                let V := mul(mload(add(p, 32)), and(shr(16, mload(0)), 0xffff))
                V := sub(V, mul(and(shr(40, mul(V, 89471204)), _QHAT24), 12289))
                let X := sub(add(U, _Q4_2), V)
