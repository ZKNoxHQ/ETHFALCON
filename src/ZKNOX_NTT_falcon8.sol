                u := sub(add(u, v), mul(shr(17, and(add(add(u, v), _C17), _G17)), 49156))
                v := mload(add(p, 0xc0))
                let w := mload(add(p, 0xe0))
                let s := mul(sub(add(v, _Q8_4), w), and(shr(240, mload(add(tb, add(70, shl(3, b))))), 0xffff))
                s := shr(16, add(s, mul(and(mul(and(s, _M16), 12287), _M16), 12289)))
                v := sub(add(v, w), mul(shr(17, and(add(add(v, w), _C17), _G17)), 49156))
                w := mul(sub(add(u, _Q8_4), v), and(shr(240, mload(add(tb, add(34, shl(2, b))))), 0xffff))
                w := shr(16, add(w, mul(and(mul(and(w, _M16), 12287), _M16), 12289)))
                u := sub(add(u, v), mul(shr(17, and(add(add(u, v), _C17), _G17)), 49156))
                v := mul(sub(add(t, _Q8_4), s), and(shr(240, mload(add(tb, add(34, shl(2, b))))), 0xffff))
                v := shr(16, add(v, mul(and(mul(and(v, _M16), 12287), _M16), 12289)))
                t := sub(add(t, s), mul(shr(17, and(add(add(t, s), _C17), _G17)), 49156))
                s := mul(sub(add(b0, _Q8_4), u), and(shr(240, mload(add(tb, add(16, shl(1, b))))), 0xffff))
                s := shr(16, add(s, mul(and(mul(and(s, _M16), 12287), _M16), 12289)))
                mstore(add(p, 0x80), s)
                mstore(p, sub(add(b0, u), mul(shr(17, and(add(add(b0, u), _C17), _G17)), 49156)))
                s := mul(sub(add(b1, _Q8_4), t), and(shr(240, mload(add(tb, add(16, shl(1, b))))), 0xffff))
                s := shr(16, add(s, mul(and(mul(and(s, _M16), 12287), _M16), 12289)))
                mstore(add(p, 0xa0), s)
                mstore(add(p, 0x20), sub(add(b1, t), mul(shr(17, and(add(add(b1, t), _C17), _G17)), 49156)))
                s := mul(sub(add(b2, _Q8_4), w), and(shr(240, mload(add(tb, add(16, shl(1, b))))), 0xffff))
                s := shr(16, add(s, mul(and(mul(and(s, _M16), 12287), _M16), 12289)))
                mstore(add(p, 0xc0), s)
                mstore(add(p, 0x40), sub(add(b2, w), mul(shr(17, and(add(add(b2, w), _C17), _G17)), 49156)))
                s := mul(sub(add(b3, _Q8_4), v), and(shr(240, mload(add(tb, add(16, shl(1, b))))), 0xffff))
                s := shr(16, add(s, mul(and(mul(and(s, _M16), 12287), _M16), 12289)))
                mstore(add(p, 0xe0), s)
                mstore(add(p, 0x60), sub(add(b3, v), mul(shr(17, and(add(add(b3, v), _C17), _G17)), 49156)))
            }
            p := add(p, 0x100)
        }
    }
}

/// @dev pass A': t = 64, 128, then t = 256 folded with 1/512 and the R of the
///      pointwise step (sums * 128R, differences * inv[1]*128R); output lanes < 3q
function _inv8PassA(uint256[] memory A) pure {
    assembly ("memory-safe") {
        let p := add(A, 32)
        for { let i := 0 } lt(i, 8) { i := add(i, 1) } {
            let b0, b1, b2, b3
            {
                let u := mload(p)
                let v := mload(add(p, 0x100))
                let t := mul(sub(add(u, _Q8_4), v), 0x9e2)
                t := shr(16, add(t, mul(and(mul(and(t, _M16), 12287), _M16), 12289)))
                u := sub(add(u, v), mul(shr(17, and(add(add(u, v), _C17), _G17)), 49156))
                v := mload(add(p, 0x200))
                let w := mload(add(p, 0x300))
                let s := mul(sub(add(v, _Q8_4), w), 0x177e)
                s := shr(16, add(s, mul(and(mul(and(s, _M16), 12287), _M16), 12289)))
                v := sub(add(v, w), mul(shr(17, and(add(add(v, w), _C17), _G17)), 49156))
                w := mul(sub(add(u, _Q8_4), v), 0x439)
                w := shr(16, add(w, mul(and(mul(and(w, _M16), 12287), _M16), 12289)))
                b0 := sub(add(u, v), mul(shr(17, and(add(add(u, v), _C17), _G17)), 49156))
                b2 := w
                w := mul(sub(add(t, _Q8_4), s), 0x439)
                w := shr(16, add(w, mul(and(mul(and(w, _M16), 12287), _M16), 12289)))
                b1 := sub(add(t, s), mul(shr(17, and(add(add(t, s), _C17), _G17)), 49156))
                b3 := w
            }
            {
                let u := mload(add(p, 0x400))
                let v := mload(add(p, 0x500))
                let t := mul(sub(add(u, _Q8_4), v), 0x1f0b)
                t := shr(16, add(t, mul(and(mul(and(t, _M16), 12287), _M16), 12289)))
                u := sub(add(u, v), mul(shr(17, and(add(add(u, v), _C17), _G17)), 49156))
                v := mload(add(p, 0x600))
                let w := mload(add(p, 0x700))
                let s := mul(sub(add(v, _Q8_4), w), 0x14d1)
                s := shr(16, add(s, mul(and(mul(and(s, _M16), 12287), _M16), 12289)))
                v := sub(add(v, w), mul(shr(17, and(add(add(v, w), _C17), _G17)), 49156))
                w := mul(sub(add(u, _Q8_4), v), 0x4cd)
                w := shr(16, add(w, mul(and(mul(and(w, _M16), 12287), _M16), 12289)))
                u := sub(add(u, v), mul(shr(17, and(add(add(u, v), _C17), _G17)), 49156))
                v := mul(sub(add(t, _Q8_4), s), 0x4cd)
                v := shr(16, add(v, mul(and(mul(and(v, _M16), 12287), _M16), 12289)))
                t := sub(add(t, s), mul(shr(17, and(add(add(t, s), _C17), _G17)), 49156))
                s := mul(sub(add(b0, _Q8_4), u), 10323)
                s := shr(16, add(s, mul(and(mul(and(s, _M16), 12287), _M16), 12289)))
                mstore(add(p, 0x400), sub(_CPL, s))
                s := mul(add(b0, u), 7510)
                s := shr(16, add(s, mul(and(mul(and(s, _M16), 12287), _M16), 12289)))
                mstore(p, sub(_CPL, s))
                s := mul(sub(add(b1, _Q8_4), t), 10323)
                s := shr(16, add(s, mul(and(mul(and(s, _M16), 12287), _M16), 12289)))
                mstore(add(p, 0x500), sub(_CPL, s))
                s := mul(add(b1, t), 7510)
                s := shr(16, add(s, mul(and(mul(and(s, _M16), 12287), _M16), 12289)))
                mstore(add(p, 0x100), sub(_CPL, s))
                s := mul(sub(add(b2, _Q8_4), w), 10323)
                s := shr(16, add(s, mul(and(mul(and(s, _M16), 12287), _M16), 12289)))
                mstore(add(p, 0x600), sub(_CPL, s))
                s := mul(add(b2, w), 7510)
                s := shr(16, add(s, mul(and(mul(and(s, _M16), 12287), _M16), 12289)))
                mstore(add(p, 0x200), sub(_CPL, s))
                s := mul(sub(add(b3, _Q8_4), v), 10323)
                s := shr(16, add(s, mul(and(mul(and(s, _M16), 12287), _M16), 12289)))
                mstore(add(p, 0x700), sub(_CPL, s))
                s := mul(add(b3, v), 7510)
                s := shr(16, add(s, mul(and(mul(and(s, _M16), 12287), _M16), 12289)))
                mstore(add(p, 0x300), sub(_CPL, s))
            }
            p := add(p, 32)
        }
    }
}

/// @notice s1 = INTT(NTT(s2) o h) for a compact s2 (16 coefficients of 16 bits
///         per word, canonical) and a compact key h; result PACKED on eight
///         32-bit lanes per word (coefficient 8w + j in lane j), each lane
///         holding 3q + 6144 - x with x < 3q congruent to s1_i: the term the
///         norm sampler (ZKNOX_falcon_core8.sol) adds to a hash candidate t
///         before its mod q, so that (t + lane) mod q - 6144 is the centred
///         difference h_i - s1_i.
function falconProduct8(uint256[] memory s2, uint256[] memory h) pure returns (uint256[] memory A) {
    require(s2.length == 32 && h.length == 32, "compact length");
    bytes memory fwt = _FW8;
    bytes memory ivt = _INV8;
    uint256 tb;
    uint256 ti;
    assembly ("memory-safe") {
        tb := add(fwt, 32)
        ti := add(ivt, 32)
    }
    A = _fw8PassA(s2);
    _fw8PassB(A, tb);
    _fw8InWord(A, h, tb, ti);
    _inv8PassB(A, ti);
    _inv8PassA(A);
}
