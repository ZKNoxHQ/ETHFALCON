64442068, 17564344674783852357247325589247473882830766139750808683064015010041459773180, 12601232530472338126510941067000966999586933909071534455578397454667291628041, 17820703520112071877812607241017358905719406745793395857586668204300579510382, 20977963461796112341763752649093803701879441191599296283127418471622134932903, 5627732773047409045458881938100601008133088383905060686572856121439798106767, 2602661464000108367786729796742170641292899005030508211661215565063118195399, 20110282897068872581106488251090599973196923955248066799683528955504800771309];// forgefmt: disable-next-line
        uint256[32] memory tmp_s2 = [uint256(21497550197847738339064296419978711348422954822656183174384710570472651489437), 21663641338882695047302719322606618823166712089311341015857936224737426026324, 21530802078896100276705945911463177274136163628807603315764700720736572354559, 260056481369331319611145276459584256842828875723616723599940449414069682254, 215885983631575593209463470377449874559469896704507600839469210976943800574, 46262734205323698603985131888580081191733003831807991517426485085475188556, 21633277838621787070696372775704768553266907148306005083520250856723305332957, 660806657587728824725383325511211888035460981068948811420751942803924910112, 21297900356791987183607865452468846952659543512798536273008122760624706432957, 247682405106535019822607721883601998282278285264935414280946971047661338889, 21407124865159308411681621558930369260227245064361820624551785471188527611984, 21536423232721691908572496335818588154583940552106905906249012225796559274139, 362533292524373398674299150323364773235486327396689675707309434061790838812, 21622674810138894100379851187283981444006719134883565537674120839177327542279, 21516664287791723380998787650523111741729801644540053507482710021445793349892, 21230438541173528545351680400516186852797894540954369849302476220281974501225, 20919475317999390872389287371851745623454401755534381694955674023222499094377, 21515218097399305985350329872839531401732900092326013135068891469843797454775, 298598722485689114237068937600104362498612736007660733126247886415847751852, 17998033964540951890339847510947157867819940249010905421951307390087135324, 258286916281929071836383567251865796506925231462735699264918187432186687310, 21548471574030012266851700345982566363744710045475660176838998756789737553942, 238525787637342486210762326591327895853330771043363084262003649669127942133, 521222930681505497902414630688801737025018926312358925567755151082681413538, 472071097518438312029691279732948159379371220068621613447547602349347962933, 100713221398136484883247463520257200775114178874915447137039334486757998697, 21672148420163965168529049785918324286932103946844965436071361771036720103586, 21615937362634967547852668806331086739538661160991729175960717497726731956213, 332167873266101650986853730280528292581839836184282744609984377924194938623, 21495787794187458109562671777318739152692756733015663158103366953397059661634, 282699628323819662144091776393399374635891331807972694788969066964214886383, 452314147700475682868527761361913574941669783881839966612218921304115982273];

        uint256[] memory pkc = new uint256[](32);
        uint256[] memory s2 = new uint256[](32);
        for (uint256 i = 0; i < 32; i++) {
            pkc[i] = tmp_pkc[i];
            s2[i] = tmp_s2[i];
        }

        pubkey = falcon.setKey(abi.encode(pkc));

        bytes memory salt =
            "\x46\xb9\xdd\x2b\x0b\xa8\x8d\x13\x23\x3b\x3f\xeb\x74\x3e\xeb\x24\x3f\xcd\x52\xea\x62\xb8\x1b\x82\xb5\x0c\x27\x64\x6e\xd5\x76\x2f\xd7\x5d\xc4\xdd\xd8\xc0\xf2\x00";
        sig = abi.encodePacked(salt, s2); // 40 + 1024 = 1064 bytes
    }

    function testCanonicalLengthVerifies() public view {
        assertEq(sig.length, SALT_LEN + 32 * falcon_S256);
        bytes4 res = falcon.verify(pubkey, digest, sig);
        assertEq(res, ISigVerifier.verify.selector, "canonical 1064-byte signature must verify");
    }

    function testAppendedBytesRejected() public {
        // Before the fix, every length in [1065, 1095] verified (floor division collision).
        for (uint256 extra = 1; extra < 32; extra++) {
            bytes memory padded = bytes.concat(sig, new bytes(extra));
            vm.expectRevert(bytes("invalid signature length"));
            falcon.verify(pubkey, digest, padded);
        }
    }

    function testTruncatedRejected() public {
        bytes memory truncated = sig;
        // drop the last byte in place
        assembly {
            mstore(truncated, 1063)
        }
        vm.expectRevert(bytes("invalid signature length"));
        falcon.verify(pubkey, digest, truncated);
    }

    function testShorterThanSaltRejected() public {
        // used to underflow (length - 40) and burn all gas in ABI encoding
        vm.expectRevert(bytes("invalid signature length"));
        falcon.verify(pubkey, digest, new bytes(39));
    }
}
